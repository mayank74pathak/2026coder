vector<int> twoSum(vector<int>& numbers, int target) {
         
    int i = 0;
    int j = numbers.size() - 1;

    while(i < j)
    {
        int sum = numbers[i] + numbers[j];

        if(sum == target)
        {
            return {i + 1, j + 1};  // 1-based index
        }
        else if(sum < target)
        {
            i++;   // need bigger sum
        }
        else
        {
            j--;   // need smaller sum
        }
    }

    return {}; // won't reach here

    }
