vector<int> rearrangeArray(vector<int>& nums) {
        vector<int>arranged(nums.size());
        int pos=0;
        int neg=1;

        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]>0)
            {
                arranged[pos]=nums[i];
                pos=pos+2;
            }
            else{
                arranged[neg]=nums[i];
            neg=neg+2;
            }
        }
    return arranged;
    }
